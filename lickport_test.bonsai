          <scr:Expression>0</scr:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Merge" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Licks</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="scr:ExpressionTransform">
          <scr:Expression>it.Lick1</scr:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:DistinctUntilChanged" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="scr:ExpressionCondition">
          <scr:Expression>it == 1</scr:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
