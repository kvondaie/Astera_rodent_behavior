            <drw:Val2>150</drw:Val2>
            <drw:Val3>255</drw:Val3>
          </drw:Color>
          <drw:Font>Segoe UI, 13pt</drw:Font>
          <drw:Origin>
            <drw:X>100</drw:X>
            <drw:Y>212</drw:Y>
          </drw:Origin>
        </Combinator>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="Text" Selector="T1" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="drw:AddText">
          <drw:Text>Licks: 0</drw:Text>
          <drw:Alignment>Center</drw:Alignment>
          <drw:LineAlignment>Center</drw:LineAlignment>
          <drw:TextRenderingHint>AntiAlias</drw:TextRenderingHint>
          <drw:Color>
            <drw:Val0>150</drw:Val0>
            <drw:Val1>150</drw:Val1>
            <drw:Val2>150</drw:Val2>
            <drw:Val3>255</drw:Val3>
          </drw:Color>
          <drw:Font>Segoe UI, 13pt</drw:Font>
          <drw:Origin>
            <drw:X>300</drw:X>
            <drw:Y>212</drw:Y>
          </drw:Origin>
        </Combinator>
      </Expression>
      <Expression xsi:type="PropertyMapping">
        <PropertyMappings>
          <Property Name="Text" Selector="T2" />
        </PropertyMappings>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="drw:AddText">
          <drw:Text>Licks: 0</drw:Text>
          <drw:Alignment>Center</drw:Alignment>
          <drw:LineAlignment>Center</drw:LineAlignment>
          <drw:TextRenderingHint>AntiAlias</drw:TextRenderingHint>
          <drw:Color>
            <drw:Val0>150</drw:Val0>
            <drw:Val1>150</drw:Val1>
            <drw:Val2>150</drw:Val2>
            <drw:Val3>255</drw:Val3>
          </drw:Color>
          <drw:Font>Segoe UI, 13pt</drw:Font>
          <drw:Origin>
            <drw:X>500</drw:X>
            <drw:Y>212</drw:Y>
          </drw:Origin>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="drw:DrawCanvas" />
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>BehaviorEvents</Name>
      </Expression>
      <Expression xsi:type="beh:Parse">
        <harp:Register xsi:type="beh:TimestampedDigitalInputState" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="scr:ExpressionTransform">
          <scr:Expression>new(it.Seconds as HarpSeconds, Convert.ToInt32(it.Value) % 2 as Lick0, (Convert.ToInt32(it.Value) / 2) % 2 as Lick1, (Convert.ToInt32(it.Value) / 4) % 2 as Lick2)</scr:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="io:CsvWriter">
          <io:FileName>lick_log.csv</io:FileName>
          <io:Append>false</io:Append>
          <io:Overwrite>false</io:Overwrite>
          <io:Suffix>Timestamp</io:Suffix>
          <io:IncludeHeader>true</io:IncludeHeader>
        </Combinator>
      </Expression>
      <Expression xsi:type="BehaviorSubject">
        <Name>Licks</Name>
      </Expression>
    </Nodes>
