      <Expression xsi:type="Combinator">
        <Combinator xsi:type="scr:ExpressionTransform">
          <scr:Expression>it.Index + 1</scr:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timer">
