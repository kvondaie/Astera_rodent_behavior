<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core" xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions" xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System" xmlns:beh="clr-namespace:Harp.Behavior;assembly=Harp.Behavior" xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp" xmlns:p1="clr-namespace:;assembly=Extensions" xmlns:cv="clr-namespace:Bonsai.Vision;assembly=Bonsai.Vision" xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:BehaviorSubject" TypeArguments="harp:HarpMessage">
        <rx:Name>Behavior Commands</rx:Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="beh:Device">
          <harp:OperationMode>Active</harp:OperationMode>
          <harp:OperationLed>On</harp:OperationLed>
          <harp:DumpRegisters>true</harp:DumpRegisters>
          <harp:VisualIndicators>On</harp:VisualIndicators>
          <harp:Heartbeat>Enabled</harp:Heartbeat>
          <harp:IgnoreErrors>false</harp:IgnoreErrors>
          <harp:PortName>COM4</harp:PortName>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>Behavior Events</Name>
      </Expression>
      <Expression xsi:type="SubscribeSubject">
        <Name>Behavior Events</Name>
      </Expression>
      <Expression xsi:type="beh:Parse">
        <harp:Register xsi:type="beh:TimestampedDigitalInputState" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:SequenceTask">
          <p1:RetractedPosition>1650</p1:RetractedPosition>
          <p1:ExtendedPosition>1900</p1:ExtendedPosition>
          <p1:CuePosition>0</p1:CuePosition>
          <p1:YPosition>1070</p1:YPosition>
          <p1:PreTrialSeconds>1.6</p1:PreTrialSeconds>
          <p1:Drop1Ms>20</p1:Drop1Ms>
          <p1:Drop2Ms>0</p1:Drop2Ms>
          <p1:GapSeconds>1</p1:GapSeconds>
          <p1:LastDropToSpoutSeconds>0.6</p1:LastDropToSpoutSeconds>
          <p1:SampleWindowSeconds>15</p1:SampleWindowSeconds>
          <p1:LicksToChoose>2</p1:LicksToChoose>
          <p1:Item2WindowSeconds>2</p1:Item2WindowSeconds>
          <p1:Reward1Ms>80</p1:Reward1Ms>
          <p1:Reward2Ms>80</p1:Reward2Ms>
          <p1:ConsumeSeconds>2</p1:ConsumeSeconds>
          <p1:TimeoutSeconds>1</p1:TimeoutSeconds>
          <p1:MaxRepeats>3</p1:MaxRepeats>
          <p1:SideSequence>AntiBias</p1:SideSequence>
          <p1:SaveVideo>true</p1:SaveVideo>
          <p1:TrialLogFile>seq_trials.csv</p1:TrialLogFile>
        </Combinator>      </Expression>
      <Expression xsi:type="MulticastSubject">
        <Name>Behavior Commands</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="scr:ExpressionTransform">
          <scr:Expression>new(it.Seconds as HarpSeconds, Convert.ToInt32(it.Value) % 2 as LickL, (Convert.ToInt32(it.Value) / 2) % 2 as LickR)</scr:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="io:CsvWriter">
          <io:FileName>seq_licks.csv</io:FileName>
          <io:Append>false</io:Append>
          <io:Overwrite>false</io:Overwrite>
          <io:Suffix>Timestamp</io:Suffix>
          <io:IncludeHeader>true</io:IncludeHeader>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:CameraCapture">
          <cv:Index>0</cv:Index>
          <cv:CaptureProperties>
            <cv:CapturePropertyAssignment>
              <cv:Property>FrameWidth</cv:Property>
              <cv:Value>640</cv:Value>
            </cv:CapturePropertyAssignment>
            <cv:CapturePropertyAssignment>
              <cv:Property>FrameHeight</cv:Property>
              <cv:Value>480</cv:Value>
            </cv:CapturePropertyAssignment>
            <cv:CapturePropertyAssignment>
              <cv:Property>Fps</cv:Property>
              <cv:Value>30</cv:Value>
            </cv:CapturePropertyAssignment>
          </cv:CaptureProperties>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:HarpFrameClock" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Frame</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="cv:VideoWriter">
          <cv:FileName>seq_video.avi</cv:FileName>
          <cv:Suffix>Timestamp</cv:Suffix>
          <cv:Buffered>true</cv:Buffered>
          <cv:Overwrite>false</cv:Overwrite>
          <cv:FourCC>FMP4</cv:FourCC>
          <cv:FrameRate>30</cv:FrameRate>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="scr:ExpressionTransform">
          <scr:Expression>new(it.FrameNumber as FrameNumber, it.HarpSeconds as HarpSeconds, it.SinceHarpMessage as SinceHarpMessage, it.PcTime.ToString("HH:mm:ss.fff") as PcTime)</scr:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="io:CsvWriter">
          <io:FileName>seq_video_frames.csv</io:FileName>
          <io:Append>false</io:Append>
          <io:Overwrite>false</io:Overwrite>
          <io:Suffix>Timestamp</io:Suffix>
          <io:IncludeHeader>true</io:IncludeHeader>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:RigCameraTransform">
          <p1:SettingsFile>tools\CameraViewer\camera_viewer.ini</p1:SettingsFile>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:CameraPreview">
          <p1:Title>Rig camera (live)</p1:Title>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:VideoGate" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:VideoGate" />
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="4" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="3" To="10" Label="Source2" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="15" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="17" To="12" Label="Source1" />
      <Edge From="10" To="18" Label="Source1" />
      <Edge From="18" To="13" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>
